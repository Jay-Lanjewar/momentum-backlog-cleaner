# Momentum Backend Configuration

# Application
PROJECT_NAME=Momentum
VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://momentum:momentum@localhost:5432/momentum

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# AI Provider Configuration
# Global AI provider default (gemini | cloudflare). Defaults to gemini.
AI_PROVIDER=gemini
# Optional Study Buddy specific provider override (gemini | cloudflare).
STUDY_BUDDY_PROVIDER=

# Gemini (AI planning & Study Buddy default)
# Must be supplied in production (e.g. Render) to enable AI-generated study plans.
# Without it, Momentum falls back to the deterministic planner.
GEMINI_API_KEY=
# Optional: override the Gemini model. Defaults to gemini-3.7-flash.
GEMINI_MODEL=gemini-3.7-flash

# Cloudflare Workers AI (Study Buddy alternative provider)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
