{
  "expo": {
    "name": "Momentum",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/generated/momentum-icon.png",
    "scheme": "momentum",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/generated/momentum-icon.png"
    },
    "android": {
      "package": "com.momentum.app",
      "adaptiveIcon": {
        "backgroundColor": "#07142F",
        "foregroundImage": "./assets/branding/generated/momentum-adaptive-foreground.png",
        "backgroundImage": "./assets/branding/generated/momentum-adaptive-background.png",
        "monochromeImage": "./assets/branding/generated/momentum-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07142F",
          "image": "./assets/branding/generated/momentum-splash.png",
          "imageWidth": 220
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2563EB",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dbd6b1d1-b2f9-4079-a433-497a4981b57b"
      }
    }
  }
}
